#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"

MAX30105 particleSensor;

// --- Heart Rate Variables ---
const byte RATE_SIZE = 8; // Increased array size for a smoother average
byte rates[RATE_SIZE];
byte rateSpot = 0;
long lastBeat = 0;
float beatsPerMinute = 0;
int beatAvg = 0;

// --- SpO2 Variables ---
long redMin = 0x7FFFFFFF, redMax = 0;
long irMin = 0x7FFFFFFF, irMax = 0;
int sampleCount = 0;
const int SAMPLES_PER_WINDOW = 100; // 1 second window at 100Hz
float currentSpo2 = 0;

// --- 20-Second Recording Variables ---
unsigned long recordingStartTime = 0;
unsigned long lastPrintTime = 0;
bool fingerDetected = false;
float spo2Sum = 0;
int spo2ValidReadings = 0;

void setup() {
  Serial.begin(115200);
  delay(3000); 

  // I2C pin mapping for XIAO ESP32C6
  Wire.begin(22, 23);

  Serial.println("Initializing MAX30102...");

  if (!particleSensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("Sensor not found. Check wiring.");
    while (1);
  }

  // Flawless FIFO Configuration
  byte ledBrightness = 50;  // 50 is an ideal mid-point to prevent sensor blinding
  byte sampleAverage = 1;   // Must be 1 to preserve waveform peaks for beat detection
  byte ledMode = 2;         // Red + IR enabled
  int sampleRate = 100;     // Perfect 100Hz timing
  int pulseWidth = 411;     // 411us pulse width
  int adcRange = 4096;      // ADC range

  particleSensor.setup(ledBrightness, sampleAverage, ledMode, sampleRate, pulseWidth, adcRange);

  Serial.println("\n=== SYSTEM READY ===");
  Serial.println("Place your finger gently on the sensor to begin recording...");
}

void loop() {
  // Check the sensor's background FIFO buffer for new data
  particleSensor.check();

  // Process all available data in the buffer
  while (particleSensor.available()) {
    long irValue = particleSensor.getFIFOIR();
    long redValue = particleSensor.getFIFORed();

    // --- 1. FINGER DETECTION & TIMER RESET ---
    if (irValue < 50000) {
      if (fingerDetected) {
        Serial.println("\n[!] Finger removed. Pausing recording...");
        fingerDetected = false;
      }
      
      // Reset variables while no finger is present
      beatAvg = 0;
      spo2Sum = 0;
      spo2ValidReadings = 0;
      
      particleSensor.nextSample();
      continue; 
    } else {
      if (!fingerDetected) {
        Serial.println("\n[✓] Finger detected! Gathering data... (Recording will print every 20 seconds)");
        fingerDetected = true;
        recordingStartTime = millis(); 
        lastPrintTime = millis();
      }
    }

    // --- 2. HEART RATE CALCULATION ---
    if (checkForBeat(irValue) == true) {
      long delta = millis() - lastBeat;
      lastBeat = millis();

      float currentBPM = 60000.0 / delta;

      // Filter out impossible human heart rates
      if (currentBPM >= 40.0 && currentBPM <= 200.0) {
        beatsPerMinute = currentBPM;
        rates[rateSpot++] = (byte)beatsPerMinute;
        rateSpot %= RATE_SIZE;

        // Calculate smooth average
        beatAvg = 0;
        int validRates = 0;
        for (byte x = 0; x < RATE_SIZE; x++) {
          if (rates[x] > 0) {
            beatAvg += rates[x];
            validRates++;
          }
        }
        if (validRates > 0) beatAvg /= validRates;
      }
    }

    // --- 3. SPO2 CALCULATION (1-Second Windows) ---
    if (redValue < redMin) redMin = redValue;
    if (redValue > redMax) redMax = redValue;
    if (irValue < irMin) irMin = irValue;
    if (irValue > irMax) irMax = irValue;

    sampleCount++;

    if (sampleCount >= SAMPLES_PER_WINDOW) {
      double redAC = redMax - redMin;
      double redDC = (redMax + redMin) / 2.0;
      double irAC = irMax - irMin;
      double irDC = (irMax + irMin) / 2.0;

      if (irDC > 0 && redDC > 0 && irAC > 0) {
        double R = (redAC / redDC) / (irAC / irDC);
        float calculatedSpo2 = 104.0 - (17.0 * R);

        // Clamp to realistic bounds
        if (calculatedSpo2 > 100.0) calculatedSpo2 = 100.0;
        if (calculatedSpo2 < 70.0) calculatedSpo2 = 70.0;

        currentSpo2 = calculatedSpo2;
        
        // Add to our 20-second running SpO2 average
        if (currentSpo2 > 80.0) { 
          spo2Sum += currentSpo2;
          spo2ValidReadings++;
        }
      }

      // Reset window tracking
      redMin = 0x7FFFFFFF; redMax = 0;
      irMin = 0x7FFFFFFF; irMax = 0;
      sampleCount = 0;
    }

    // Advance to next sample in FIFO
    particleSensor.nextSample();
  }

  // --- 4. 20-SECOND LOGGING RECORD ---
  if (fingerDetected) {
    unsigned long currentTime = millis();
    
    // Print a dot every 2 seconds to show the user it is working
    if (currentTime - lastPrintTime >= 2000) {
      Serial.print(".");
      lastPrintTime = currentTime;
    }

    // Every 20 seconds, print the finalized record
    if (currentTime - recordingStartTime >= 20000) {
      
      float finalSpo2Avg = 0;
      if (spo2ValidReadings > 0) {
        finalSpo2Avg = spo2Sum / spo2ValidReadings;
      }

      Serial.println("\n");
      Serial.println("=========================================");
      Serial.println("         20-SECOND HEALTH RECORD         ");
      Serial.println("=========================================");
      
      if (beatAvg > 0) {
        Serial.print("  Average Heart Rate : ");
        Serial.print(beatAvg);
        Serial.println(" BPM");
      } else {
        Serial.println("  Average Heart Rate : [Calculating... Keep still]");
      }

      if (finalSpo2Avg > 0) {
        Serial.print("  Blood Oxygen (SpO2): ");
        Serial.print(finalSpo2Avg, 1);
        Serial.println(" %");
      } else {
        Serial.println("  Blood Oxygen (SpO2): [Calculating... Keep still]");
      }                                                  
      
      Serial.println("=========================================\n");

      // Reset the 20-second timer and SpO2 sums for the next batch
      recordingStartTime = millis();
      spo2Sum = 0;
      spo2ValidReadings = 0;
    }
  }
}
