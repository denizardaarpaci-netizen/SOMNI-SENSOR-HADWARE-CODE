#include <Wire.h>

#define SDA_PIN 22
#define SCL_PIN 23
#define ACCEL_ADDR 0x18

bool writeReg(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(ACCEL_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

bool readRegs(uint8_t reg, uint8_t *data, uint8_t count) {
  Wire.beginTransmission(ACCEL_ADDR);
  Wire.write(reg | 0x80); // Auto-increment registers

  if (Wire.endTransmission(false) != 0) return false;

  if (Wire.requestFrom(ACCEL_ADDR, count) != count) return false;

  for (uint8_t i = 0; i < count; i++) {
    data[i] = Wire.read();
  }
  return true;
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  uint8_t id;

  if (!readRegs(0x0F, &id, 1)) {
    Serial.println("Sensor communication failed.");
    while (true) delay(1000);
  }

  Serial.printf("WHO_AM_I: 0x%02X\n", id);

  if (id != 0x33) {
    Serial.println("Unexpected chip ID. Stopping.");
    while (true) delay(1000);
  }

  // LIS3DH: 100 Hz, normal mode, XYZ enabled
  writeReg(0x20, 0x57);

  // Block-data update, high-resolution, +/-2g
  writeReg(0x23, 0x88);

  Serial.println("Accelerometer ready!");
  Serial.println("X_g,Y_g,Z_g");
}

void loop() {
  uint8_t data[6];

  if (readRegs(0x28, data, 6)) {
    int16_t x = (int16_t)((data[1] << 8) | data[0]);
    int16_t y = (int16_t)((data[3] << 8) | data[2]);
    int16_t z = (int16_t)((data[5] << 8) | data[4]);

    // High-resolution output is left-justified 12-bit data
    x >>= 4;
    y >>= 4;
    z >>= 4;

    Serial.printf("%.3f,%.3f,%.3f\n",
                  x * 0.001f,
                  y * 0.001f,
                  z * 0.001f);
  } else {
    Serial.println("Acceleration read failed.");
  }

  delay(100);
}
