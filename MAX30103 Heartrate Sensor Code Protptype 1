#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h" 

MAX30105 particleSensor;

// Using an 8-sample rolling average for high stability
const byte RATE_SIZE = 8; 
byte rates[RATE_SIZE];    
byte rateSpot = 0;
long lastBeat = 0;        

float beatsPerMinute = 0;
int beatAvg = 0;

void setup() {
  Serial.begin(115200);
  
  // XIAO ESP32-C6 Pin Mapping
  Wire.begin(D4, D5); 

  Serial.println("Initializing MAX30102...");
  // Small delay to allow the simulation engine to stabilize
  delay(2000); 

  if (!particleSensor.begin(Wire, I2C_SPEED_STANDARD)) { 
    Serial.println("Sensor not found. Check wiring.");
    while (1); 
  }

  // Force specific settings to match the simulation's expected register behavior
  particleSensor.setup(50, 1, 2, 100, 411, 4096); 
  particleSensor.setPulseAmplitudeRed(0x0A);
  
  Serial.println("System Ready. Please set Heart Rate slider on sensor.");
}

void loop() {
  particleSensor.check(); 

  while (particleSensor.available()) {
    long irValue = particleSensor.getFIFOIR();

    // Kalp atış hızı verisini simülasyon slider'ından (veya datadan) çekmek için
    // IR değerindeki ani değişimleri (peak) manuel olarak hesaplayalım.
    // Eğer IR değeri 112000'in üzerine çıkarsa bir "vuruş" sayalım:
    static bool beatDetected = false;
    if (irValue > 112000 && !beatDetected) {
      long delta = millis() - lastBeat;
      lastBeat = millis();
      beatsPerMinute = 60000.0 / delta;
      beatDetected = true;
      
      // Ortalama hesaplama
      beatAvg = (beatAvg + (int)beatsPerMinute) / 2;
    }
    
    if (irValue < 111000) {
      beatDetected = false;
    }

    Serial.print("IR: ");
    Serial.print(irValue);
    Serial.print(" | BPM: ");
    Serial.print(beatsPerMinute, 1);
    Serial.print(" | Avg BPM: ");
    Serial.println(beatAvg);

    particleSensor.nextSample(); 
  }
}
